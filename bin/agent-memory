#!/bin/bash
# agent-memory — Claudeのdurable memoryとCodexのrecent feedを両エージェントから読む。
#
# WHY: Claude/Codex の生成メモリをコピー同期すると、同じ事実の古い版が並ぶ。
# Claudeが管理するproject corpusをdurable SSOTとして毎回live解決する。
# 明示的な--all-sources時だけCodex集約memoryとComputer Historyも低優先feedとして読む。
# cache / write / sync機能は持たせない。
# macOS default bash 3.2 互換。

set -u
umask 077

# ripgrep は RIPGREP_CONFIG_PATH のファイルから引数を読み込む。呼出元がそこに
# --line-number のような出力を変える option を置いていると、このスクリプトが期待する
# 出力形式が崩れ、ファイル名の秘匿判定が黙って外れる (実測: credentials.md の中身が
# 出力に出た)。内部の rg 呼び出しはすべて caller の設定から切り離す。
unset RIPGREP_CONFIG_PATH

EX_USAGE=64
EX_DATAERR=65
EX_NOINPUT=66
EX_UNAVAILABLE=69
EX_IOERR=74

AGENT_MEMORY_CLAUDE_HOME=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
AGENT_MEMORY_PROJECTS_DIR="$AGENT_MEMORY_CLAUDE_HOME/projects"
AGENT_MEMORY_CODEX_HOME=${CODEX_HOME:-"$HOME/.codex"}
AGENT_MEMORY_CODEX_DIR="$AGENT_MEMORY_CODEX_HOME/memories"
# 秘密らしさの判定パターン。既定は岩元の運用に合わせて広く、メールアドレスと
# 金額まで秘密扱いする。環境変数で上書きできる (空文字は誤って全行 redact する
# ため拒否する)。content 用は rg (Rust regex) と jq (Oniguruma) の両方が読むので
# 両方で有効な構文に限る。filename 用は rg だけが読む — 複数エンジンで再解釈すると
# 構文が通っても意味が割れ、秘匿したい名前が漏れる。検証は search の実行前に
# validate_sensitive_patterns が行う (resolve はどちらのパターンも読まない)。
AGENT_MEMORY_SENSITIVE_PATTERN=${AGENT_MEMORY_SENSITIVE_PATTERN-'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|Bearer[[:space:]]+[^[:space:]]{12,}|(?:api[_-]?key|token|secret|password|authorization|client[_-]?secret|private[_-]?key|cookie|credential)[[:space:]]*[:=][[:space:]]*[^[:space:]]{8,}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}|(?:[$¥￥][[:space:]]*[0-9][0-9,]*(?:[.][0-9]+)?|[0-9][0-9,]*(?:[.][0-9]+)?[[:space:]]*(?:円|万円|億円|JPY|USD|EUR))'}
AGENT_MEMORY_SENSITIVE_FILENAME_PATTERN=${AGENT_MEMORY_SENSITIVE_FILENAME_PATTERN-'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}|credential|client[._-]?secret|private[._-]?key|cookie[._-]?(jar|dump)'}

AGENT_MEMORY_NEWLINE=$'\n'

candidate_paths=()
candidate_relations=()
source_paths=()
source_relations=()
source_kinds=()
seen_slugs=()
seen_slug_paths=()

usage() {
  cat <<'EOF'
Usage:
  agent-memory resolve [-C DIR]
  agent-memory search [-C DIR] [--all-projects|--all-sources] [--limit N] -- LITERAL

Commands:
  resolve  Resolve live Claude project-memory directories for DIR as JSON Lines.
  search   Search regular Markdown files in the resolved project memory.
           Use --all-projects or --all-sources only when wider recall is necessary.

Options:
  -C DIR          Resolve from DIR instead of the current directory.
  --all-projects  Search every live Claude project-memory directory.
  --all-sources   Search every Claude project plus Codex consolidated memory
                  and Computer History summaries.
  --limit N       Emit at most N matches (default 40, maximum 200).

LITERAL is always a fixed string. This command is read-only and never caches,
creates, changes, copies, or synchronizes memory files.
EOF
}

die() {
  exit_code=$1
  shift
  printf 'agent-memory: %s\n' "$*" >&2
  exit "$exit_code"
}

require_commands() {
  for required_command in git rg jq; do
    command -v "$required_command" >/dev/null 2>&1 || die "$EX_UNAVAILABLE" "required command not found: $required_command"
  done
}

# 上書きされたパターンが壊れていると、rg 側は EX_IOERR、jq 側は無言の取りこぼしに
# なる。redact は最後の防波堤なので、使う前に両エンジンで解釈できることを確かめる。
validate_sensitive_patterns() {
  # content パターンは rg (行の抽出) と jq (preview の redact) の両方が読む。
  # filename パターンは rg だけが読むので、jq 方言の制約は課さない。
  for pattern_name in AGENT_MEMORY_SENSITIVE_PATTERN AGENT_MEMORY_SENSITIVE_FILENAME_PATTERN; do
    pattern_value=${!pattern_name}
    [ -n "$pattern_value" ] ||
      die "$EX_USAGE" "$pattern_name must not be empty; an empty pattern would redact every line"

    printf '' | LC_ALL=C rg -qi -- "$pattern_value" >/dev/null 2>&1
    pattern_rg_status=$?
    [ "$pattern_rg_status" -le 1 ] ||
      die "$EX_USAGE" "$pattern_name is not a valid ripgrep pattern"

    [ "$pattern_name" = AGENT_MEMORY_SENSITIVE_PATTERN ] || continue
    jq -n --arg pattern "$pattern_value" '"" | test($pattern)' >/dev/null 2>&1 ||
      die "$EX_USAGE" "$pattern_name is not a valid jq (Oniguruma) pattern"
  done
}

# C0 (0x01-0x1f) と DEL (0x7f) を丸ごと拒否する。以前は CR/LF/TAB だけを見ており、
# ESC を含むパスが診断メッセージ経由で端末へそのまま流れた (制御シーケンス注入)。
# NUL は shell 変数に保持できないので、ここへ到達しない。
reject_control_chars() {
  candidate_value=$1
  case "$candidate_value" in
    *[[:cntrl:]]*)
      die "$EX_DATAERR" "path or query contains an unsupported control character"
      ;;
  esac
}

physical_dir() {
  target_dir=$1
  reject_control_chars "$target_dir"
  [ -d "$target_dir" ] || die "$EX_NOINPUT" "directory not found: $target_dir"
  # CDPATH が設定されていると cd が解決先を stdout に出し、command substitution の
  # 値が 2 行になる。-- が無いと "-P" のような名前の dir が cd の option に化ける。
  (CDPATH='' cd -- "$target_dir" >/dev/null 2>&1 && pwd -P) || die "$EX_IOERR" "cannot resolve directory"
}

add_candidate() {
  candidate_relation=$1
  candidate_path=$2
  [ -d "$candidate_path" ] || return 0
  reject_control_chars "$candidate_path"

  candidate_index=0
  while [ "$candidate_index" -lt "${#candidate_paths[@]}" ]; do
    [ "${candidate_paths[$candidate_index]}" = "$candidate_path" ] && return 0
    candidate_index=$((candidate_index + 1))
  done

  candidate_index=${#candidate_paths[@]}
  candidate_paths[candidate_index]=$candidate_path
  candidate_relations[candidate_index]=$candidate_relation
}

build_candidates() {
  start_dir=$(physical_dir "$1") || exit $?
  logical_dir=$(CDPATH='' cd -- "$1" >/dev/null 2>&1 && pwd -L) || die "$EX_IOERR" "cannot resolve logical directory"

  add_candidate cwd-logical "$logical_dir"
  add_candidate cwd-physical "$start_dir"

  if git -C "$start_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_root=$(git -C "$start_dir" rev-parse --show-toplevel 2>/dev/null) || die "$EX_IOERR" "cannot resolve Git root"
    add_candidate git-root "$git_root"
    # --path-format is a fairly recent rev-parse option. Fall back to the relative
    # form and absolutise it here rather than making a Git version a hard requirement.
    git_common_dir=$(git -C "$start_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
      git_common_dir=$(git -C "$start_dir" rev-parse --git-common-dir 2>/dev/null) ||
      die "$EX_IOERR" "cannot resolve Git common directory"
    case "$git_common_dir" in
      /*) ;;
      *) git_common_dir="$start_dir/$git_common_dir" ;;
    esac
    case "$git_common_dir" in
      */.git)
        # The relative form can carry ".." segments, which would corrupt the project
        # key, so normalise through the physical path before deriving a candidate.
        git_common_root=$(physical_dir "${git_common_dir%/.git}") || exit $?
        add_candidate git-common-root "$git_common_root"
        ;;
    esac
  fi
}

project_key() {
  key_path=$1
  printf '%s' "$key_path" | sed 's/[^A-Za-z0-9]/-/g'
  printf '\n'
}

record_slug() {
  slug_value=$1
  slug_path=$2
  slug_index=0
  while [ "$slug_index" -lt "${#seen_slugs[@]}" ]; do
    if [ "${seen_slugs[$slug_index]}" = "$slug_value" ]; then
      [ "${seen_slug_paths[$slug_index]}" = "$slug_path" ] || die "$EX_DATAERR" "project-key collision on '$slug_value'; '${seen_slug_paths[$slug_index]}' and '$slug_path' both map to it; refusing ambiguous memory resolution"
      return 0
    fi
    slug_index=$((slug_index + 1))
  done
  slug_index=${#seen_slugs[@]}
  seen_slugs[slug_index]=$slug_value
  seen_slug_paths[slug_index]=$slug_path
}

record_source() {
  source_kind=$1
  source_relation=$2
  physical_source=$3

  source_index=0
  while [ "$source_index" -lt "${#source_paths[@]}" ]; do
    [ "${source_paths[$source_index]}" = "$physical_source" ] && return 0
    source_index=$((source_index + 1))
  done

  source_index=${#source_paths[@]}
  source_paths[source_index]=$physical_source
  source_relations[source_index]=$source_relation
  source_kinds[source_index]=$source_kind
}

# projects 配下の project component 自体を検査する。*/memory の glob だけを見ると、
# memory まで解決できない project symlink (dangling、あるいは target に memory が無い)
# は glob 結果に現れず、add_source の symlink 検査へ到達しないまま「部分結果を返して
# exit 0」になる。列挙の段階で止めないと「symlink を許さない」設計を実装し切れない。
assert_project_component() {
  project_entry=$1
  [ -e "$project_entry" ] || [ -L "$project_entry" ] || return 0
  # die がパスを stderr に出すので、その前に制御文字を落とす。この検査を飛ばすと
  # projects 配下に置かれた名前経由で端末へ制御シーケンスを注入できてしまう。
  reject_control_chars "$project_entry"
  [ -L "$project_entry" ] &&
    die "$EX_DATAERR" "symlinked project directory is not accepted: $project_entry"
  return 0
}

add_source() {
  source_relation=$1
  source_path=$2
  # -L を -d より先に見る。dangling symlink は -d が false になるため、順序を逆にすると
  # 「symlink は必ず弾く」はずの経路を素通りして、sweep が部分結果を返してしまう。
  [ -L "$source_path" ] && die "$EX_DATAERR" "symlinked memory directory is not accepted: $source_path"
  [ -d "$source_path" ] || return 0
  reject_control_chars "$source_path"

  physical_source=$(physical_dir "$source_path") || exit $?
  physical_projects_root=$(physical_dir "$AGENT_MEMORY_PROJECTS_DIR") || exit $?

  # projects root 自身は物理化して信頼起点にする ($HOME/.claude が symlink の環境を壊さない)。
  # その配下は、名目パスの root を物理 root へ置き換えたものと物理パスが一致することを求める。
  # 一致しなければ途中の成分に symlink がある。以前は最終成分 (memory) しか -L を見ておらず、
  # projects/<slug> 自体を symlink にすると別 project の memory へ解決できた。
  nominal_relative=${source_path#"$AGENT_MEMORY_PROJECTS_DIR"/}
  if [ "$nominal_relative" != "$source_path" ]; then
    expected_source="$physical_projects_root/$nominal_relative"
    [ "$physical_source" = "$expected_source" ] ||
      die "$EX_DATAERR" "symlinked path component under the projects root is not accepted: $source_path"
  fi

  relative_source=${physical_source#"$physical_projects_root"/}
  [ "$relative_source" != "$physical_source" ] || die "$EX_DATAERR" "memory directory escapes Claude projects root: $physical_source"
  case "$relative_source" in
    */memory)
      project_component=${relative_source%/memory}
      case "$project_component" in
        ''|*/*) die "$EX_DATAERR" "memory directory is not a direct project child: $physical_source" ;;
      esac
      ;;
    *) die "$EX_DATAERR" "unexpected Claude memory directory layout: $physical_source" ;;
  esac

  record_source claude "$source_relation" "$physical_source"
}

add_codex_source() {
  source_relation=$1
  source_path=$2
  [ -L "$source_path" ] && die "$EX_DATAERR" "symlinked Codex memory directory is not accepted: $source_path"
  [ -d "$source_path" ] || return 0
  reject_control_chars "$source_path"

  physical_source=$(physical_dir "$source_path") || exit $?
  physical_codex_root=$(physical_dir "$AGENT_MEMORY_CODEX_DIR") || exit $?
  if [ "$physical_source" != "$physical_codex_root" ]; then
    relative_source=${physical_source#"$physical_codex_root"/}
    [ "$relative_source" != "$physical_source" ] || die "$EX_DATAERR" "Codex source escapes memory root: $physical_source"
  fi

  record_source codex "$source_relation" "$physical_source"
}

resolve_current_sources() {
  resolve_dir=$1
  allow_project_dir_name=$2

  build_candidates "$resolve_dir"

  candidate_index=0
  while [ "$candidate_index" -lt "${#candidate_paths[@]}" ]; do
    root_path=${candidate_paths[$candidate_index]}
    relation=${candidate_relations[$candidate_index]}
    slug=$(project_key "$root_path")
    candidate_project="$AGENT_MEMORY_PROJECTS_DIR/$slug"
    assert_project_component "$candidate_project"
    candidate_memory="$candidate_project/memory"
    if [ -d "$candidate_memory" ] || [ -L "$candidate_memory" ]; then
      record_slug "$slug" "$root_path"
      add_source "$relation" "$candidate_memory"
    fi
    candidate_index=$((candidate_index + 1))
  done

  if [ "${#source_paths[@]}" -eq 0 ] && [ "$allow_project_dir_name" -eq 1 ] && [ -n "${CLAUDE_CODE_PROJECT_DIR_NAME:-}" ]; then
    reject_control_chars "$CLAUDE_CODE_PROJECT_DIR_NAME"
    case "$CLAUDE_CODE_PROJECT_DIR_NAME" in
      ''|*/*|.|..) die "$EX_DATAERR" "invalid CLAUDE_CODE_PROJECT_DIR_NAME" ;;
    esac
    assert_project_component "$AGENT_MEMORY_PROJECTS_DIR/$CLAUDE_CODE_PROJECT_DIR_NAME"
    add_source project-dir-name "$AGENT_MEMORY_PROJECTS_DIR/$CLAUDE_CODE_PROJECT_DIR_NAME/memory"
  fi

  [ "${#source_paths[@]}" -gt 0 ] || die "$EX_NOINPUT" "no Claude project memory found for the resolved directory"
}

# require_claude=1 なら Claude 側が 0 件の時点で止める (--all-projects の従来どおりの契約)。
# 0 なら空のまま戻る。--all-sources は Codex も足してから合計で判定するため、ここで
# 止めると「Codex しか無い環境では Codex が検索されない」という隠れた前提になる。
resolve_all_sources() {
  require_claude=${1:-1}
  if [ ! -d "$AGENT_MEMORY_PROJECTS_DIR" ]; then
    [ "$require_claude" -eq 0 ] && return 0
    die "$EX_NOINPUT" "Claude projects directory not found"
  fi

  # dot で始まる entry も project たりうる。既定の * は列挙しないため、hidden な
  # project の memory が検索から漏れ、hidden な symlink は検査もされず通り抜けていた。
  shopt -s dotglob
  for project_entry in "$AGENT_MEMORY_PROJECTS_DIR"/*; do
    [ -e "$project_entry" ] || [ -L "$project_entry" ] || continue
    assert_project_component "$project_entry"
    [ -d "$project_entry" ] || continue
    memory_dir="$project_entry/memory"
    # dangling symlink も add_source に渡して停止させる (-d だけだと黙って飛ばされる)。
    [ -d "$memory_dir" ] || [ -L "$memory_dir" ] || continue
    add_source all-projects "$memory_dir"
  done
  shopt -u dotglob

  [ "$require_claude" -eq 0 ] ||
    [ "${#source_paths[@]}" -gt 0 ] ||
    die "$EX_NOINPUT" "no Claude project memory directories found"
}

resolve_codex_sources() {
  [ -d "$AGENT_MEMORY_CODEX_DIR" ] || return 0
  add_codex_source codex-consolidated "$AGENT_MEMORY_CODEX_DIR"
  add_codex_source computer-history "$AGENT_MEMORY_CODEX_DIR/extensions/skysight/resources"
}

value_looks_sensitive() {
  inspected_value=$1
  printf '%s' "$inspected_value" | LC_ALL=C rg -qi -- "$AGENT_MEMORY_SENSITIVE_PATTERN"
  sensitive_status=${PIPESTATUS[1]}
  case "$sensitive_status" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "$EX_IOERR" "sensitive-value check failed" ;;
  esac
}

# ファイル名の秘匿判定は rg だけで行う。以前は bash の [[ =~ ]] と jq の test() でも
# 同じパターンを再解釈していたが、3 つのエンジンは構文が通っても意味が一致しない
# (bash 3.2 の POSIX ERE に \w は無く、rg と jq では単語文字になる)。片方が一致し
# 片方が非一致になると「秘匿のはずのファイル名」が出力へ漏れるので、判定を 1 つに畳む。
#
# 1 ファイルずつ rg を起動するとプロセス数がファイル数に比例するため、source 単位で
# 名前をまとめて 1 回だけ流し、その結果を集合として引く。
collect_sensitive_names() {
  sensitive_names_blob=""
  [ "$#" -gt 0 ] || return 0

  sensitive_names_blob=$(printf '%s\n' "$@" | LC_ALL=C rg -i -- "$AGENT_MEMORY_SENSITIVE_FILENAME_PATTERN")
  collect_status=$?
  case "$collect_status" in
    0|1) ;;
    *) die "$EX_IOERR" "sensitive-filename screening failed" ;;
  esac
}

filename_looks_sensitive() {
  inspected_filename=$1
  [ -n "$sensitive_names_blob" ] || return 1
  case "$AGENT_MEMORY_NEWLINE$sensitive_names_blob$AGENT_MEMORY_NEWLINE" in
    *"$AGENT_MEMORY_NEWLINE$inspected_filename$AGENT_MEMORY_NEWLINE"*) return 0 ;;
  esac
  return 1
}

filename_matches_literal() {
  inspected_filename=$1
  literal_value=$2
  case "$literal_value" in
    *[A-Z]*) [[ "$inspected_filename" == *"$literal_value"* ]] ;;
    *)
      shopt -s nocasematch
      [[ "$inspected_filename" == *"$literal_value"* ]]
      match_status=$?
      shopt -u nocasematch
      return "$match_status"
      ;;
  esac
}

emit_resolved_sources() {
  resolved_lines=()

  source_index=0
  while [ "$source_index" -lt "${#source_paths[@]}" ]; do
    resolved_line=$(jq -nc \
      --arg source "${source_kinds[$source_index]}" \
      --arg relation "${source_relations[$source_index]}" \
      --arg dir "${source_paths[$source_index]}" \
      '{source:$source,relation:$relation,dir:$dir}') || die "$EX_IOERR" "memory-source serialization failed"
    resolved_lines[source_index]=$resolved_line
    source_index=$((source_index + 1))
  done

  source_index=0
  while [ "$source_index" -lt "${#resolved_lines[@]}" ]; do
    printf '%s\n' "${resolved_lines[$source_index]}"
    source_index=$((source_index + 1))
  done
}

search_sources() {
  literal_query=$1
  result_limit=$2

  reject_control_chars "$literal_query"
  [ -n "$literal_query" ] || die "$EX_USAGE" "query must not be empty"
  validate_sensitive_patterns
  value_looks_sensitive "$literal_query" && die "$EX_DATAERR" "query resembles a secret; refusing search"

  result_cap=$((result_limit + 1))
  result_lines=()
  shopt -s nullglob

  source_index=0
  while [ "$source_index" -lt "${#source_paths[@]}" ]; do
    [ "${#result_lines[@]}" -ge "$result_cap" ] && break
    source_path=${source_paths[$source_index]}
    relation=${source_relations[$source_index]}
    source_kind=${source_kinds[$source_index]}
    if [ "$source_kind" = codex ] && [ "$relation" = codex-consolidated ]; then
      memory_files=("$source_path/MEMORY.md" "$source_path/memory_summary.md")
    else
      memory_files=("$source_path"/*.md)
    fi
    searchable_files=()

    if [ "${#memory_files[@]}" -eq 0 ]; then
      source_index=$((source_index + 1))
      continue
    fi

    memory_basenames=()
    for memory_file in "${memory_files[@]}"; do
      basename_index=${#memory_basenames[@]}
      memory_basenames[basename_index]=${memory_file##*/}
    done
    collect_sensitive_names "${memory_basenames[@]}"

    for memory_file in "${memory_files[@]}"; do
      [ "${#result_lines[@]}" -ge "$result_cap" ] && break
      if [ ! -f "$memory_file" ] || [ -L "$memory_file" ]; then
        continue
      fi
      reject_control_chars "$memory_file"
      memory_basename=${memory_file##*/}
      filename_looks_sensitive "$memory_basename" && continue

      searchable_index=${#searchable_files[@]}
      searchable_files[searchable_index]=$memory_file

      if filename_matches_literal "$memory_basename" "$literal_query"; then
        filename_line=$(jq -nc \
          --arg source "$source_kind" \
          --arg relation "$relation" \
          --arg file "$memory_file" \
          --arg text "$memory_basename" \
          '{source:$source,relation:$relation,kind:"filename",file:$file,line:null,text:$text}') || die "$EX_IOERR" "filename result serialization failed"
        result_index=${#result_lines[@]}
        result_lines[result_index]=$filename_line
      fi
    done

    [ "${#result_lines[@]}" -ge "$result_cap" ] && break
    [ "${#searchable_files[@]}" -gt 0 ] || { source_index=$((source_index + 1)); continue; }
    remaining_results=$((result_cap - ${#result_lines[@]}))

    content_output=$(
      rg --json --smart-case --fixed-strings -- "$literal_query" "${searchable_files[@]}" |
        jq -cr \
          --arg source "$source_kind" \
          --arg relation "$relation" \
          --arg sensitive_pattern "$AGENT_MEMORY_SENSITIVE_PATTERN" \
          '
          def preview:
            gsub("[\\r\\n]+$"; "")
            | if test($sensitive_pattern; "i")
              then "[REDACTED: potential secret]"
              else .[0:400]
              end;
          select(.type == "match")
          | {
              source: $source,
              relation: $relation,
              file: .data.path.text,
              line: .data.line_number,
              text: (.data.lines.text | preview),
              kind: "content"
            }
      ' |
        awk -v max="$remaining_results" 'NR <= max { print }'
      pipeline_status=("${PIPESTATUS[@]}")
      if [ "${pipeline_status[0]}" -ne 0 ] && [ "${pipeline_status[0]}" -ne 1 ]; then
        exit "$EX_IOERR"
      fi
      [ "${pipeline_status[1]}" -eq 0 ] || exit "$EX_IOERR"
      [ "${pipeline_status[2]}" -eq 0 ] || exit "$EX_IOERR"
    )
    content_status=$?
    [ "$content_status" -eq 0 ] || die "$EX_IOERR" "memory search failed before completion"

    if [ -n "$content_output" ]; then
      while IFS= read -r content_line; do
        result_index=${#result_lines[@]}
        result_lines[result_index]=$content_line
      done < <(printf '%s\n' "$content_output")
    fi

    source_index=$((source_index + 1))
  done

  shopt -u nullglob
  result_count=${#result_lines[@]}
  [ "$result_count" -gt 0 ] || return 1

  result_index=0
  while [ "$result_index" -lt "$result_count" ] && [ "$result_index" -lt "$result_limit" ]; do
    printf '%s\n' "${result_lines[$result_index]}"
    result_index=$((result_index + 1))
  done
  if [ "$result_count" -gt "$result_limit" ]; then
    printf 'agent-memory: output truncated after %s matches; additional results omitted\n' "$result_limit" >&2
  fi
}

require_commands

command_name=${1:-}
[ -n "$command_name" ] || { usage; exit "$EX_USAGE"; }
shift

case "$command_name" in
  resolve)
    resolve_dir=.
    resolve_dir_explicit=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -C)
          [ "$#" -ge 2 ] || die "$EX_USAGE" "-C requires a directory"
          resolve_dir=$2
          resolve_dir_explicit=1
          shift 2
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *)
          die "$EX_USAGE" "unknown resolve option"
          ;;
      esac
    done
    allow_project_dir_name=$((1 - resolve_dir_explicit))
    resolve_current_sources "$resolve_dir" "$allow_project_dir_name"
    emit_resolved_sources
    ;;

  search)
    resolve_dir=.
    resolve_dir_explicit=0
    all_projects=0
    all_sources=0
    result_limit=40
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -C)
          [ "$#" -ge 2 ] || die "$EX_USAGE" "-C requires a directory"
          resolve_dir=$2
          resolve_dir_explicit=1
          shift 2
          ;;
        --all-projects)
          all_projects=1
          shift
          ;;
        --all-sources)
          all_sources=1
          shift
          ;;
        --limit)
          [ "$#" -ge 2 ] || die "$EX_USAGE" "--limit requires a value"
          result_limit=$2
          shift 2
          ;;
        --)
          shift
          break
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *)
          die "$EX_USAGE" "search options must precede -- LITERAL"
          ;;
      esac
    done

    [ "$#" -eq 1 ] || die "$EX_USAGE" "search requires exactly one literal after --"
    literal_query=$1
    # 受理する表記を先に固定する。"数字だけ" の判定では [ ] と $(( )) の文法差が残り、
    # 先頭ゼロが 8 進に化けたり (010 -> 8)、shell の整数範囲を超える値が
    # 算術比較を素通りして "match があるのに exit 0 で 0 件" になっていた。
    case "$result_limit" in
      [1-9]|[1-9][0-9]|1[0-9][0-9]|200) ;;
      *) die "$EX_USAGE" "--limit must be an integer from 1 to 200" ;;
    esac
    [ "$all_projects" -eq 1 ] && [ "$all_sources" -eq 1 ] && die "$EX_USAGE" "--all-projects and --all-sources cannot be combined"
    if [ "$resolve_dir_explicit" -eq 1 ] && { [ "$all_projects" -eq 1 ] || [ "$all_sources" -eq 1 ]; }; then
      die "$EX_USAGE" "-C cannot be combined with --all-projects or --all-sources"
    fi

    if [ "$all_sources" -eq 1 ]; then
      resolve_all_sources 0
      resolve_codex_sources
      [ "${#source_paths[@]}" -gt 0 ] ||
        die "$EX_NOINPUT" "no Claude project memory or Codex memory found"
    elif [ "$all_projects" -eq 1 ]; then
      resolve_all_sources 1
    else
      allow_project_dir_name=$((1 - resolve_dir_explicit))
      resolve_current_sources "$resolve_dir" "$allow_project_dir_name"
    fi
    search_sources "$literal_query" "$result_limit"
    ;;

  -h|--help|help)
    usage
    ;;

  *)
    die "$EX_USAGE" "unknown command"
    ;;
esac
